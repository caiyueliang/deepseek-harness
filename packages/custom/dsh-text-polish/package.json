{
  "name": "dsh-text-polish",
  "version": "1.0.0",
  "description": "Composer button for DeepSeek Harness: rewrite the draft in place — polish ordinary prose, expand a task into a detailed request.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "prompt",
    "polish",
    "expand",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiyueliang/dsh-text-polish.git"
  },
  "homepage": "https://github.com/caiyueliang/dsh-text-polish#readme",
  "bugs": {
    "url": "https://github.com/caiyueliang/dsh-text-polish/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
